{
  \"\": \"https://railway.app/railway.schema.json\",
  \"build\": {
    \"builder\": \"NIXPACKS\",
    \"buildCommand\": \"pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate && python manage.py crear_superusuario\"
  },
  \"deploy\": {
    \"startCommand\": \"gunicorn CoworkSpaceKC.wsgi --log-file -\",
    \"restartPolicyType\": \"ON_FAILURE\",
    \"restartPolicyMaxRetries\": 10
  }
}
